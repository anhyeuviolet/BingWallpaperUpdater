<Project>

  <!--
    Shared, harmless build knobs for every project in the solution.
    Publish identity (runtime identifier, self-contained, single-file) lives ONLY in
    src/BingWallpaperUpdater.App/BingWallpaperUpdater.App.csproj - putting it here breaks the
    test project with NETSDK1191 (RESEARCH Pitfall 2). The resource-key stripping switch is
    deliberately absent: it strips exception messages at runtime (RESEARCH Pitfall 3).
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>false</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <SatelliteResourceLanguages>en;vi</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
    <!--
      Filled in Phase 4 (Plan 04-03). Lands in the generated AssemblyInfo as the RepositoryUrl assembly
      metadata and is consumed by HttpGateway.DefaultUserAgent() as the "(+<repo>)" suffix, so the
      User-Agent reads "BingWallpaperUpdater/<ver> (+https://github.com/anhyeuviolet/BingWallpaperUpdater)".
      <Version> above is the local default; CI overrides it through tools/build-installer.ps1 -Version.
    -->
    <RepositoryUrl>https://github.com/anhyeuviolet/BingWallpaperUpdater</RepositoryUrl>
  </PropertyGroup>

</Project>
